# Copy to .env for local runs (.env is git-ignored). Never commit real values.
# In GitHub Actions these come from repo Settings -> Secrets and variables -> Actions.

# GitHub token with the "models" permission (only needed outside GitHub Actions)
GITHUB_TOKEN=
# SEC requires "Name email" on every request (Day 2)
SEC_USER_AGENT=
# Supabase Postgres connection string (Day 4)
SUPABASE_DB_URL=
